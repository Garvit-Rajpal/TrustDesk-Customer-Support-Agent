DATABASE_URL=postgres://trustdesk:trustdesk@localhost:5432/trustdesk
DATABASE_URL_TEST=postgres://trustdesk:trustdesk@localhost:5432/trustdesk_test
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
JWT_SECRET=change-me-in-production
MODEL_NAME=openrouter/auto
PORT=3000
# V2-6 (LLD_v2 §7): mock | local | hosted. Unset infers hosted if
# OPENAI_API_KEY is set, else mock (v1 behavior, unchanged).
MODEL_TIER=local
# local tier only — Ollama's OpenAI-compatible endpoint (npm run smoke:local)
OPENAI_BASE_URL_LOCAL=http://localhost:11434/v1

# V4-10 (LLD_v4 §5, HLD_v4 ADR-21): mock | local | hosted, mirrors
# MODEL_TIER. Unset infers hosted only from EMBEDDINGS_API_KEY — never from
# OPENAI_API_KEY, which points at OpenRouter (no embeddings endpoint).
EMBEDDING_TIER=local
# local tier: an Ollama embedding-capable model, e.g. nomic-embed-text,
# via OPENAI_BASE_URL_LOCAL above.
EMBEDDING_MODEL_NAME=nomic-embed-text
# hosted tier only — a small, purchased embeddings API, distinct from
# OPENAI_API_KEY/OPENAI_BASE_URL.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
